{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mycityai/bridge_stats.schema.json",
  "title": "Police → Municipal aggregated statistics",
  "description": "Aggregated, anonymised counts only. No individual incidents, images, video or personal data. Unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["period", "accident_hotspots", "congestion"],
  "properties": {
    "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "accident_hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location_id", "name", "lat", "lng", "accidents"],
        "properties": {
          "location_id": { "type": "string", "maxLength": 64 },
          "name": { "type": "string", "maxLength": 120 },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "accidents": { "type": "integer", "minimum": 0 },
          "peak_hours": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "congestion": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["road", "peak_windows", "avg_speed_kmph"],
        "properties": {
          "road": { "type": "string", "maxLength": 120 },
          "peak_windows": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$" } },
          "avg_speed_kmph": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
