# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://mycity:mycity@localhost:5433/mycity_municipal
# Dashboard (5173) + citizen app in the browser (Expo web, 8081). Add LAN IPs to test from other devices.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
# Development only: every OTP is this value (ignored when APP_ENV=production)
DEV_OTP=123456

# Password given to all seeded staff accounts by `python -m app.seed`
SEED_STAFF_PASSWORD=mycity-dev

# Uploaded photos (served at /media)
MEDIA_DIR=media

# Push notifications to the citizen app (Expo push service). false = only log them.
PUSH_ENABLED=true

# AI — Google Gemini (https://aistudio.google.com/apikey). Leave empty to use the keyword fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local photo detection with YOLO (pip install -r requirements-ml.txt). Model list: ml/vision/models.json
VISION_ENABLED=true
MODELS_DIR=models

# Utilities agent: key the (simulated) sensors send in the X-Sensor-Key header. Change in production.
SENSOR_API_KEY=dev-sensor-key
# LSTM demand forecast (PyTorch + ml/forecasting/models.json); false = seasonal forecast only
FORECAST_LSTM_ENABLED=true

# Background jobs (auto-close after 72 h, SLA escalation)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# Deployment: only accept photos taken with the camera on the spot (geotagged, recent).
# Keep false while testing with gallery photos; set true in production.
REQUIRE_LIVE_PHOTOS=false
MAX_PHOTO_AGE_MINUTES=15
MAX_GPS_ACCURACY_M=50
MAX_PHOTO_DISTANCE_M=100
