# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://mycity:mycity@localhost:5433/mycity_municipal
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
# Development only: every OTP is this value (ignored when APP_ENV=production)
DEV_OTP=123456

# Password given to all seeded staff accounts by `python -m app.seed`
SEED_STAFF_PASSWORD=mycity-dev

# Uploaded photos (served at /media)
MEDIA_DIR=media
