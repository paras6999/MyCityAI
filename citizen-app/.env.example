# Copy to .env. Never commit real .env files. EXPO_PUBLIC_* values are bundled into the app: no secrets here.
# Backend base URL. On a physical phone use your PC's LAN IP, e.g. http://192.168.1.5:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# true = run against in-app mock data that matches docs/API.md (no backend needed)
EXPO_PUBLIC_USE_MOCKS=false
