# Copy to .env. Never commit real .env files. EXPO_PUBLIC_* values are bundled into the app: no secrets here.
# Backend base URL. On a physical phone use your PC's LAN IP, e.g. http://192.168.1.5:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# true = run against in-app mock data that matches docs/API.md (no backend needed)
EXPO_PUBLIC_USE_MOCKS=false
# Keep true: Expo SDK 57's default fetch (expo/fetch) cannot upload photos added to FormData as
# { uri, name, type }, so complaint photos fail with "Cannot reach the server" on phones.
# true = use React Native's own fetch, which supports them.
EXPO_PUBLIC_USE_RN_FETCH=true
